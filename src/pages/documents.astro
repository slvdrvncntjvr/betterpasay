---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import documents from '../data/documents.json';
import { sourceFor, formatDate } from '../lib/content';
const collections = [
  { id: 'all', title: 'All documents' },
  { id: 'charters', title: 'Citizen’s Charter' },
  { id: 'service-guides', title: 'Service guides' },
  { id: 'forms', title: 'Forms & templates' },
  { id: 'reports', title: 'Public reports' },
  { id: 'policies', title: 'Ordinances & policies' },
];
---

<Base
  title="Document library"
  description="Find official Pasay service guides, charter sections, procurement forms and public records, with original sources and review dates."
>
  <div class="document-library">
    <PageIntro
      eyebrow="Document library"
      title="The paperwork, in one place."
      description="Official guides, forms and public records. Find what you need, see where it came from, and open the original."
    />
    <section class="container library-body" aria-labelledby="library-heading">
      <div class="library-overview">
        <div>
          <p class="eyebrow">A clearer starting point</p>
          <h2 id="library-heading">Find your next document.</h2>
          <p>
            Looking for a birth, marriage or death certificate? Start with the
            civil registry guide below. The city issues the record after your
            request; these links explain how to apply.
          </p>
        </div>
        <a class="charter-feature" href={sourceFor('charter').url}>
          <Icon name="book" size={30} />
          <span>
            <strong>Citizen’s Charter 2026</strong>
            <small>The full city handbook · PDF · about 28.5 MB</small>
          </span>
          <Icon name="external" size={19} />
        </a>
      </div>
      <div class="library-controls" data-library-controls hidden>
        <label class="search-label" for="document-search">
          Search the library
        </label>
        <div class="document-search">
          <Icon name="search" size={22} />
          <input
            id="document-search"
            type="search"
            placeholder="Try birth certificate, PWD, or budget…"
            autocomplete="off"
          />
          <kbd aria-hidden="true">Search</kbd>
        </div>
        <div
          class="collection-filters"
          role="group"
          aria-label="Document collection"
        >
          {collections.map((collection) => (
            <button
              type="button"
              data-collection={collection.id}
              aria-pressed={collection.id === 'all'}
            >
              {collection.title}
              <span>
                {collection.id === 'all'
                  ? documents.length
                  : documents.filter(
                      (document) => document.category === collection.id,
                    ).length}
              </span>
            </button>
          ))}
        </div>
      </div>
      <div class="library-results-bar">
        <p id="document-result-count" role="status" aria-live="polite">
          {documents.length} documents & source collections
        </p>
        <span>Original sources · No account needed here</span>
      </div>
      <div class="document-grid">
        {documents.map((document) => {
          const source = sourceFor(document.sourceId);
          const serviceId =
            'serviceId' in document ? document.serviceId : undefined;
          return (
            <article
              class="document-card"
              data-document-card
              data-category={document.category}
              data-search={[
                document.title,
                document.description,
                document.edition,
                source.publisher,
                source.title,
                collections.find(
                  (collection) => collection.id === document.category,
                )?.title,
              ].join(' ')}
            >
              <div class="document-card-top">
                <span class="file-icon">
                  <Icon
                    name={
                      document.category === 'charters' ? 'book' : 'document'
                    }
                    size={25}
                  />
                </span>
                <span class="file-label">
                  {source.format === 'PDF' ? 'PDF' : 'WEB INDEX'}
                </span>
              </div>
              <p class="document-collection">
                {
                  collections.find(
                    (collection) => collection.id === document.category,
                  )?.title
                }
              </p>
              <h3>{document.title}</h3>
              <p class="document-description">{document.description}</p>
              <div class="document-meta">
                <span>{document.edition}</span>
                <span>{document.pages}</span>
                {document.sourceId.startsWith('charter-') && (
                  <span>Full charter PDF · about 28.5 MB</span>
                )}
              </div>
              <dl class="document-dates">
                <div>
                  <dt>Published</dt>
                  <dd>
                    {source.publishedAt ? (
                      <time datetime={source.publishedAt}>
                        {formatDate(source.publishedAt)}
                      </time>
                    ) : (
                      'Date not stated'
                    )}
                  </dd>
                </div>
                <div>
                  <dt>Checked</dt>
                  <dd>
                    <time datetime={source.checkedAt}>
                      {formatDate(source.checkedAt)}
                    </time>
                  </dd>
                </div>
              </dl>
              <details class="document-review">
                <summary>Source & review notes</summary>
                <p>
                  {source.publisher}. {source.note}
                </p>
                {document.sourceId === 'laws' && (
                  <a href="https://pasay.gov.ph/transparency/">
                    City page linking this collection ↗
                  </a>
                )}
              </details>
              <div class="document-actions">
                <a class="source-action" href={source.url}>
                  {source.format === 'PDF'
                    ? 'Open official PDF'
                    : 'Visit official collection'}
                  <Icon name="external" size={16} />
                </a>
                {serviceId && (
                  <a class="guide-action" href={`/services/${serviceId}/`}>
                    Read our guide
                    <Icon name="arrow" size={16} />
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
      <div class="library-empty" id="document-empty" hidden>
        <Icon name="search" size={32} />
        <h3>No matching documents yet.</h3>
        <p>Try fewer words or choose another collection.</p>
        <button type="button" id="clear-document-search">
          Clear search & filters
        </button>
        <a href="https://pasay.gov.ph/contact-us/">
          Ask the city about an unlisted document ↗
        </a>
      </div>
      <aside class="library-note">
        <Icon name="message" size={25} />
        <div>
          <h2>Know what you’re opening.</h2>
          <p>
            Service guides explain a process; they are not blank application
            forms. Charter page links open the full PDF, and page jumps depend
            on your PDF viewer. Publication dates stay “not stated” when only an
            upload folder or edition year is known.
          </p>
          <a href="/services/">
            Explore services by task <Icon name="arrow" size={16} />
          </a>
        </div>
      </aside>
    </section>
  </div>
</Base>

<script>
  import { matches } from '../lib/search';
  const input = document.querySelector<HTMLInputElement>('#document-search');
  const controls = document.querySelector<HTMLElement>(
    '[data-library-controls]',
  );
  const cards = [
    ...document.querySelectorAll<HTMLElement>('[data-document-card]'),
  ];
  const buttons = [
    ...document.querySelectorAll<HTMLButtonElement>('[data-collection]'),
  ];
  const count = document.querySelector<HTMLElement>('#document-result-count');
  const empty = document.querySelector<HTMLElement>('#document-empty');
  let collection = 'all';
  const update = () => {
    let visible = 0;
    for (const card of cards) {
      const show =
        (collection === 'all' || card.dataset.category === collection) &&
        matches(card.dataset.search ?? '', input?.value ?? '');
      card.hidden = !show;
      if (show) visible++;
    }
    for (const button of buttons)
      button.setAttribute(
        'aria-pressed',
        String(button.dataset.collection === collection),
      );
    if (count)
      count.textContent = `${visible} ${visible === 1 ? 'document or source collection' : 'documents & source collections'}`;
    if (empty) empty.hidden = visible > 0;
  };
  input?.addEventListener('input', update);
  for (const button of buttons)
    button.addEventListener('click', () => {
      collection = button.dataset.collection ?? 'all';
      update();
    });
  document
    .querySelector('#clear-document-search')
    ?.addEventListener('click', () => {
      collection = 'all';
      if (input) input.value = '';
      update();
      input?.focus();
    });
  if (controls) controls.hidden = false;
</script>

<style>
  .document-library {
    background: #fff;
    color: #132d50;
  }
  .document-library :global(h1),
  .document-library :global(h2) {
    font-family: var(--sans);
    font-weight: 700;
  }
  .library-body {
    padding-bottom: 80px;
  }
  .library-overview {
    border-top: 1px solid #dce3ed;
    border-bottom: 1px solid #dce3ed;
    padding: 32px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .library-overview .eyebrow {
    color: #536781;
    margin-bottom: 10px;
  }
  .library-overview h2 {
    font-size: 1.6rem;
    margin-bottom: 12px;
  }
  .library-overview p:last-child {
    color: #4b607a;
    margin: 0;
    font-size: 0.92rem;
  }
  .charter-feature {
    display: flex;
    gap: 20px;
    align-items: center;
    border-radius: 12px;
    padding: 28px;
    color: #fff;
    background: #102d51;
    text-decoration: none;
    border-left: 5px solid #ffda59;
  }
  .charter-feature:hover {
    color: #ffda59;
  }
  .charter-feature > span {
    flex: 1;
  }
  .charter-feature strong {
    font-size: 1.08rem;
    display: block;
  }
  .charter-feature small {
    font-size: 0.78rem;
    color: #d7e2f1;
    display: block;
    margin-top: 6px;
  }
  .library-controls {
    padding-top: 32px;
  }
  .search-label {
    display: block;
    margin-bottom: 10px;
    font-weight: 700;
    font-size: 0.83rem;
  }
  .document-search {
    display: flex;
    align-items: center;
    gap: 16px;
    border: 1px solid #bdcbdb;
    padding: 0 20px;
    background: #f7f9fc;
    border-radius: 10px;
  }
  .document-search:focus-within {
    outline: 3px solid #b18b12;
    outline-offset: 3px;
  }
  .document-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    background: transparent;
    padding: 19px 0;
    color: #132d50;
    outline: 0;
    font-size: 1rem;
  }
  .document-search input::placeholder {
    color: #61718a;
  }
  .document-search kbd {
    border: 1px solid #d1dbe7;
    border-radius: 4px;
    padding: 2px 8px;
    color: #536781;
    font: 0.7rem var(--sans);
  }
  .collection-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    padding: 20px 0 25px;
  }
  .collection-filters button {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 43px;
    padding: 9px 14px;
    border: 1px solid #d5deea;
    border-radius: 7px;
    background: #fff;
    color: #314c6d;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .collection-filters button[aria-pressed='true'] {
    color: #fff;
    background: #102d51;
    border-color: #102d51;
  }
  .collection-filters button span {
    font-size: 0.66rem;
    background: #edf1f7;
    color: #314c6d;
    padding: 1px 6px;
    border-radius: 4px;
  }
  .collection-filters button[aria-pressed='true'] span {
    background: #ffda59;
    color: #102d51;
  }
  .library-results-bar {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid #dce3ed;
    padding: 20px 0;
    font-size: 0.78rem;
    color: #536781;
  }
  .library-results-bar p {
    margin: 0;
    font-weight: 600;
  }
  .library-results-bar > span {
    font-size: 0.72rem;
  }
  .document-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .document-card {
    border: 1px solid #dce3ed;
    border-radius: 12px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .document-card:hover {
    border-color: #9aafc8;
    box-shadow: 0 6px 24px #102d5109;
  }
  .document-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
  }
  .file-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: #eef3f9;
    color: #173e70;
  }
  .file-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 4px 9px;
    border: 1px solid #dce3ed;
    border-radius: 5px;
  }
  .document-collection {
    color: #536781;
    font-size: 0.67rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 8px;
  }
  .document-card h3 {
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.025em;
    margin-bottom: 13px;
  }
  .document-description {
    color: #4b607a;
    font-size: 0.86rem;
    line-height: 1.7;
    margin-bottom: 17px;
  }
  .document-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: #536781;
    font-size: 0.71rem;
    margin-top: auto;
    padding-top: 6px;
  }
  .document-dates {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 16px 0 12px;
  }
  .document-dates dt {
    font-size: 0.64rem;
    text-transform: uppercase;
    color: #536781;
    letter-spacing: 0.06em;
  }
  .document-dates dd {
    margin: 2px 0 0;
    font-size: 0.7rem;
    color: #304d70;
  }
  .document-review {
    font-size: 0.72rem;
    color: #536781;
    margin-bottom: 19px;
  }
  .document-review summary {
    cursor: pointer;
    width: fit-content;
  }
  .document-review p {
    margin: 10px 0 0;
  }
  .document-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-top: 1px solid #e3e9f1;
    padding-top: 18px;
  }
  .document-actions a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 700;
  }
  .source-action {
    color: #173e70;
  }
  .source-action:hover,
  .guide-action:hover {
    color: #775800;
    text-decoration: underline;
  }
  .guide-action {
    color: #536781;
  }
  .library-empty {
    text-align: center;
    padding: 60px 20px;
    background: #f4f7fb;
    border-radius: 12px;
  }
  .library-empty h3 {
    margin-top: 16px;
  }
  .library-empty button {
    display: block;
    margin: 18px auto;
    padding: 12px 20px;
    border: 0;
    border-radius: 6px;
    background: #102d51;
    color: #fff;
  }
  .library-empty a {
    font-size: 0.85rem;
  }
  .library-note {
    display: flex;
    gap: 20px;
    padding: 28px;
    margin-top: 40px;
    background: #fff9e6;
    border: 1px solid #e7daad;
    border-radius: 12px;
  }
  .library-note h2 {
    font-size: 1.15rem;
    margin-bottom: 10px;
  }
  .library-note p {
    font-size: 0.86rem;
    color: #4b607a;
    margin-bottom: 12px;
  }
  .library-note a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
    font-weight: 700;
  }
  @media (max-width: 1000px) {
    .document-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .library-overview {
      gap: 26px;
    }
  }
  @media (max-width: 640px) {
    .document-grid,
    .library-overview {
      grid-template-columns: 1fr;
    }
    .library-results-bar > span,
    .document-search kbd {
      display: none;
    }
    .document-card {
      padding: 22px;
    }
    .charter-feature {
      padding: 22px;
    }
    .library-note {
      padding: 22px;
      gap: 13px;
    }
  }
</style>
