---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { services, categories, resources, project } from '../lib/content';
import city from '../data/city.json';
const quickLinks = [
  {
    title: 'Documents & certificates',
    description: 'Civil registry, clearances & IDs',
    icon: 'document',
    href: '/services/?category=documents',
    color: 'blue',
  },
  {
    title: 'Business & property',
    description: 'Permits, taxes & applications',
    icon: 'building',
    href: '/services/?category=business',
    color: 'amber',
  },
  {
    title: 'Health & family',
    description: 'Care, benefits & community support',
    icon: 'heart',
    href: '/services/?category=family',
    color: 'rose',
  },
  {
    title: 'Jobs & livelihood',
    description: 'Employment & opportunities',
    icon: 'work',
    href: '/services/?category=work',
    color: 'violet',
  },
];
const popular = [
  'community-tax',
  'business-permit',
  'senior-citizen-id',
  'real-property-tax',
  'mayors-clearance',
  'job-openings',
].map((id) => services.find((item) => item.id === id)!);
---

<Base
  title="Your city. Your guide. A better Pasay."
  description="Your community-built guide to Pasay City. Find public services, official documents, barangays, city information and transparent government resources in one place."
>
  <section class="home-hero" aria-labelledby="welcome-title">
    <img
      class="hero-photo"
      src="/images/pasay-bay.webp"
      alt="Pasay’s Mall of Asia complex overlooking Manila Bay, photographed in 2016"
      width="1280"
      height="854"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="container hero-content">
      <div class="hero-copy">
        <p class="hero-kicker">
          <span class="status-dot"></span> PARA SA BAWAT PASAYEÑO
        </p>
        <h1 id="welcome-title">
          Your city.
          <br />
          Your guide.
          <br />
          <span>A better Pasay.</span>
        </h1>
        <p class="hero-description">
          Less searching. More living.
          <br />
          Services, public information, and the city you call home—all in one
          place.
        </p>
        <div class="hero-buttons">
          <a class="button button-yellow" href="/services/">
            Explore city services <Icon name="arrow" size={18} />
          </a>
          <a class="hero-secondary" href="/city/">
            Get to know Pasay <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="hero-community">
          <span class="tiny-avatars" aria-hidden="true">
            <span>P</span>
            <span>A</span>
            <span>S</span>
          </span>
          <span>For the people. By the community.</span>
        </div>
      </div>
      <div class="hero-location">
        <Icon name="pin" size={17} />
        <span>
          Bay City, Pasay<span>A VIEW OF HOME · 2016</span>
        </span>
        <a href="/about/#credits" aria-label="Photo credit and license">
          <Icon name="external" size={15} />
        </a>
      </div>
      <span class="hero-side-label" aria-hidden="true">
        METRO MANILA, PHILIPPINES
      </span>
    </div>
  </section>
  <div class="container find-panel">
    <div class="find-heading">
      <span class="icon-box">
        <Icon name="search" size={22} />
      </span>
      <div>
        <h2>How can we help you today?</h2>
        <p>Find your next step, without the runaround.</p>
      </div>
      <span class="find-tag">YOUR EVERYDAY CITY GUIDE</span>
    </div>
    <form class="home-search" action="/services/" role="search">
      <Icon name="search" size={21} />
      <label class="sr-only" for="home-search">
        Search public services
      </label>
      <input
        id="home-search"
        name="q"
        type="search"
        maxlength="160"
        placeholder="Try ‘birth certificate’, ‘business permit’, or ‘sedula’…"
      />
      <button class="button" type="submit" aria-label="Search services">
        Find a service <Icon name="arrow" size={18} />
      </button>
    </form>
    <p class="popular-searches">
      <span>Popular searches</span>
      <a href="/services/?q=sedula">Sedula</a>
      <a href="/services/?q=permit">Business permit</a>
      <a href="/services/?q=senior">Senior citizen ID</a>
      <a href="/services/?q=trabaho">Job opportunities</a>
    </p>
  </div>
  <section
    class="section container home-services"
    aria-labelledby="services-title"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">A LITTLE LESS COMPLICATED</p>
        <h2 id="services-title">City services, made easier.</h2>
        <p class="section-description">
          Start with what you need. We’ll point you in the right direction.
        </p>
      </div>
      <a class="text-link" href="/services/">
        All {services.length} services <Icon name="arrow" size={17} />
      </a>
    </div>
    <div class="quick-grid">
      {quickLinks.map((item) => (
        <a class={`quick-card ${item.color}`} href={item.href}>
          <span class="quick-icon">
            <Icon name={item.icon} size={26} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <span class="quick-bottom">
            Explore services <Icon name="arrow" size={17} />
          </span>
        </a>
      ))}
    </div>
    <div class="popular-service-list">
      {popular.map((service) => (
        <a href={`/services/${service.id}/`}>
          <Icon
            name={
              categories.find((item) => item.id === service.category)?.icon ??
              'document'
            }
            size={18}
          />
          <span>{service.title}</span>
          <Icon name="arrow" size={16} />
        </a>
      ))}
    </div>
  </section>
  <section class="city-feature" aria-labelledby="city-title">
    <div class="container city-feature-grid">
      <div class="city-photo-wrap">
        <img
          src="/images/manila-bay-sunset.webp"
          alt="Sunset over Manila Bay, photographed from Pasay’s seaside in 2017"
          width="1200"
          height="900"
          loading="lazy"
        />
        <span class="photo-label">
          <Icon name="pin" size={15} /> A little closer to home.
        </span>
        <div class="city-photo-note">
          <Icon name="sun" size={25} />
          <span>
            There’s more
            <br />
            <strong>to our city.</strong>
          </span>
        </div>
      </div>
      <div class="city-feature-copy">
        <p class="eyebrow">MEET YOUR CITY</p>
        <h2 id="city-title">
          More than a gateway.
          <br />
          This is <span>home.</span>
        </h2>
        <p>
          From the neighborhoods of Malibay to the shores of Manila Bay, Pasay
          is a city of connections, culture, and everyday stories.
        </p>
        <p>
          Get to know its history, explore its places, and find the people and
          offices serving your community.
        </p>
        <a class="button" href="/city/">
          Discover Pasay <Icon name="arrow" size={17} />
        </a>
        <div class="city-mini-links">
          <a href="/barangays/">
            <Icon name="pin" size={18} />
            Find your barangay <Icon name="arrow" size={16} />
          </a>
          <a href="/government/">
            <Icon name="people" size={18} />
            Meet your government <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="home-facts container" aria-label="Pasay at a glance">
    <div class="facts-intro">
      <p class="eyebrow">A CITY OF CONNECTIONS</p>
      <h2>Pasay, at a glance.</h2>
      <a href="/city/">
        Get the bigger picture <Icon name="arrow" size={15} />
      </a>
    </div>
    <a href={city.sources.psgc.url}>
      <strong>{city.statistics.population2024.toLocaleString('en-PH')}</strong>
      <span>People who call it home</span>
      <small>PSA · 2024 POPCEN ↗</small>
    </a>
    <a href="/barangays/">
      <strong>{city.statistics.barangays}</strong>
      <span>Barangays. One city.</span>
      <small>Explore our communities →</small>
    </a>
    <a href={city.sources.profile.url}>
      <strong>{city.statistics.zones}</strong>
      <span>Administrative zones</span>
      <small>Official city profile ↗</small>
    </a>
  </section>
  <section class="section container" aria-labelledby="open-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">PUBLIC INFORMATION. PUBLIC GOOD.</p>
        <h2 id="open-title">Your city, in the open.</h2>
        <p class="section-description">
          Follow the records. Understand the decisions. Stay informed.
        </p>
      </div>
      <a class="text-link" href="/transparency/">
        Explore transparency <Icon name="arrow" size={17} />
      </a>
    </div>
    <div class="open-grid">
      <a href="/transparency/#resource-0" class="open-card">
        <span class="icon-box">
          <Icon name="chart" size={24} />
        </span>
        <span class="eyebrow">PUBLIC FINANCES</span>
        <h3>Where the money goes</h3>
        <p>
          Explore city budget reports and financial disclosures at the original
          source.
        </p>
        <span class="text-link">
          View public finances <Icon name="arrow" size={17} />
        </span>
      </a>
      <a href="/transparency/#resource-1" class="open-card">
        <span class="icon-box">
          <Icon name="building" size={24} />
        </span>
        <span class="eyebrow">PROCUREMENT</span>
        <h3>What the city is buying</h3>
        <p>
          Find invitations to bid, procurement plans, and published award
          notices.
        </p>
        <span class="text-link">
          Explore procurement <Icon name="arrow" size={17} />
        </span>
      </a>
      <a href="/documents/" class="open-card">
        <span class="icon-box">
          <Icon name="book" size={24} />
        </span>
        <span class="eyebrow">DOCUMENTS & GUIDES</span>
        <h3>The details that matter</h3>
        <p>
          Read official service guides, the Citizen’s Charter, and city
          documents.
        </p>
        <span class="text-link">
          Open the library <Icon name="arrow" size={17} />
        </span>
      </a>
    </div>
    <p class="source-note">
      <Icon name="shield" size={15} /> {resources.length} transparency resources
      linked to original publishers. Source review dates are included.
    </p>
  </section>
  <section class="help-section">
    <div class="container help-grid">
      <div>
        <p class="eyebrow">SAVE THESE FOR WHEN THEY MATTER</p>
        <h2>
          A little help.
          <br />
          When you need it most.
        </h2>
        <p>Keep Pasay’s emergency and assistance contacts within reach.</p>
        <a class="text-link" href="/contact/">
          All contacts & hotlines <Icon name="arrow" size={17} />
        </a>
      </div>
      <div class="home-hotlines">
        <a href="tel:+639178672263">
          <span class="hotline-icon">
            <Icon name="phone" size={21} />
          </span>
          <span>
            <small>DISASTER & EMERGENCY RESPONSE</small>
            <strong>0917 867 2263</strong>
            <span>Pasay DRRMO Command Center</span>
          </span>
          <Icon name="arrow" size={18} />
        </a>
        <a href="tel:+63288442120">
          <span class="hotline-icon fire">
            <Icon name="shield" size={21} />
          </span>
          <span>
            <small>FIRE EMERGENCIES</small>
            <strong>(02) 8844 2120</strong>
            <span>Pasay City Fire Station</span>
          </span>
          <Icon name="arrow" size={18} />
        </a>
        <p>
          <a href="https://pasay.gov.ph/">Source: Pasay City Government</a> ·
          Checked 28 October 2026
        </p>
      </div>
    </div>
  </section>
  <section class="section container">
    <div class="community-callout">
      <span class="community-callout-icon">
        <Icon name="people" size={38} />
      </span>
      <div>
        <p class="eyebrow">SMALL CONTRIBUTIONS. A BETTER CITY.</p>
        <h2>Made for Pasay. Better with you.</h2>
        <p>
          Spot a missing detail? Have a source to share? Help make public
          information work for everyone.
        </p>
      </div>
      <a class="button" href="/about/#contribute">
        Be part of it <Icon name="arrow" size={17} />
      </a>
    </div>
    <div class="trust-line">
      <span>
        <Icon name="people" size={17} /> Community maintained
      </span>
      <span>
        <Icon name="shield" size={17} /> Official sources, clearly linked
      </span>
      <a href={project.repository}>
        <Icon name="globe" size={17} /> Open source & free to use{' '}
        <Icon name="external" size={13} />
      </a>
    </div>
  </section>
</Base>
