---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import city from '../data/city.json';
import { formatDate } from '../lib/content';
const sources = city.sources;
const sourceFor = (key: string) => sources[key as keyof typeof sources];
const sourceKeys = [
  'mayor',
  'viceMayor',
  'representative',
  'council',
  'internal',
  'external',
  'contact',
] as const;
---

<Base
  title="Pasay government directory"
  description="Find Pasay’s mayor, vice mayor, representative, city council and resident-facing city offices, with official directory sources and room numbers."
>
  <PageIntro
    eyebrow="Government"
    title="Know who to turn to."
    description="Meet the city’s elected leaders and find the office that handles your concern. Each listing leads back to the official city directory."
  />
  <div class="container government-content">
    <p class="review">
      Sources reviewed{' '}
      <time datetime={city.reviewedAt}>{formatDate(city.reviewedAt)}</time> ·{' '}
      <a href="#sources">View sources</a>
    </p>
    <nav class="page-links" aria-label="On this page">
      <a href="#leadership">City leaders</a>
      <a href="#council">City council</a>
      <a href="#offices">Find an office</a>
      <a href="/contact/">Contact City Hall →</a>
    </nav>
    <section id="leadership" class="content-section">
      <p class="eyebrow">Public leadership</p>
      <h2>Your city representatives.</h2>
      <p class="section-description">
        Names, rooms and extensions below were checked against each office’s own
        city government page. Office locations are in Pasay City Hall.
      </p>
      <div class="leader-grid">
        {city.leadership.map((leader) => (
          <article>
            <div class="leader-mark">
              <Icon
                name={
                  leader.office === 'City Representative'
                    ? 'people'
                    : 'building'
                }
                size={30}
              />
            </div>
            <p class="eyebrow">{leader.office}</p>
            <h3>{leader.name}</h3>
            <p>{leader.role}</p>
            <dl>
              <div>
                <dt>City Hall room</dt>
                <dd>{leader.room}</dd>
              </div>
              <div>
                <dt>Trunkline extension</dt>
                <dd>{leader.extension}</dd>
              </div>
            </dl>
            <a class="text-link" href={sourceFor(leader.source).url}>
              Official office page <Icon name="external" size={16} />
            </a>
          </article>
        ))}
      </div>
      <p class="directory-note">
        City Hall trunkline: <a href="tel:+63288872729">(02) 8887 2729</a>. Ask
        for the listed extension.{' '}
        <a href={sources.contact.url}>City contact source ↗</a>
      </p>
    </section>
    <section id="council" class="content-section">
      <p class="eyebrow">Sangguniang Panlungsod</p>
      <h2>The city council.</h2>
      <p class="section-description">
        The city directory groups councilors into two local districts and lists
        ex officio members separately. These local council districts are
        distinct from the city’s representation in Congress.
      </p>
      <div class="council-grid">
        {city.council.map((group) => (
          <article>
            <h3>{group.group}</h3>
            <ul>
              {group.names.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <a class="text-link" href={sources.council.url}>
        Official council directory & member profiles{' '}
        <Icon name="external" size={17} />
      </a>
    </section>
    <section id="offices" class="content-section">
      <p class="eyebrow">Start with the right office</p>
      <h2>What do you need help with?</h2>
      <p class="section-description">
        These room numbers and extensions are published in the city’s internal
        department directory. Dial the City Hall trunkline and ask for the
        extension.
      </p>
      <div
        class="table-scroll"
        role="region"
        aria-label="City office directory"
        tabindex="0"
      >
        <table>
          <caption>
            Selected city offices · reviewed{formatDate(city.reviewedAt)}
          </caption>
          <thead>
            <tr>
              <th scope="col">Concern / office</th>
              <th scope="col">City Hall room</th>
              <th scope="col">Extension</th>
            </tr>
          </thead>
          <tbody>
            {city.offices.map((office) => (
              <tr>
                <th scope="row">
                  <strong>{office.purpose}</strong>
                  <span>{office.name}</span>
                </th>
                <td>{office.room}</td>
                <td>{office.extension}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="source-line">
        Source:{' '}
        <a href={sources.internal.url}>
          Pasay City internal department directory ↗
        </a>
        . PIO’s contact page also lists extension 1285; the department directory
        lists 1284.
      </p>
      <div class="directory-links">
        <a href={sources.internal.url}>
          <Icon name="building" size={25} />
          <span>
            <strong>All internal departments</strong>
            <small>City Hall offices, room numbers and extensions</small>
          </span>
          <Icon name="external" size={17} />
        </a>
        <a href={sources.external.url}>
          <Icon name="people" size={25} />
          <span>
            <strong>External departments & facilities</strong>
            <small>
              Hospital, traffic, senior citizens and other facilities
            </small>
          </span>
          <Icon name="external" size={17} />
        </a>
      </div>
    </section>
    <aside class="help-box">
      <div>
        <h2>Visiting City Hall?</h2>
        <p>
          {city.cityHall.address}. Find the published inquiry hours, PIO email
          and emergency contacts on our contact page.
        </p>
      </div>
      <a class="text-link" href="/contact/">
        Plan your contact <Icon name="arrow" size={19} />
      </a>
    </aside>
    <section id="sources" class="sources">
      <h2>Sources & review</h2>
      <p>
        Reviewed {formatDate(city.reviewedAt)}. This is a snapshot of the
        official listings; the linked directories provide the city’s latest
        published details.
      </p>
      <ul>
        {sourceKeys.map((key) => (
          <li>
            <a href={sources[key].url}>
              {sources[key].title}
              <span>{sources[key].url}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .government-content {
    color: #142d50;
    padding-bottom: 70px;
  }
  .review,
  .source-line,
  .directory-note {
    font-size: 0.79rem;
    color: #53657a;
  }
  .page-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    padding: 12px 0 25px;
    font-size: 0.87rem;
  }
  .content-section {
    padding: 35px 0 50px;
    border-top: 1px solid #dbe3ed;
  }
  .content-section h2,
  .help-box h2,
  .sources h2 {
    font-family: var(--sans);
    font-weight: 750;
    letter-spacing: -0.04em;
  }
  .eyebrow {
    color: #596b81;
  }
  .section-description {
    font-size: 0.9rem;
    line-height: 1.75;
    max-width: 800px;
    color: #53657a;
  }
  .leader-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 28px;
  }
  .leader-grid article {
    padding: 28px;
    background: #fff;
    border: 1px solid #dbe3ed;
    border-top: 4px solid #edbf4b;
    border-radius: 7px;
    display: flex;
    flex-direction: column;
    align-items: start;
  }
  .leader-mark {
    background: #edf2f8;
    color: #173f70;
    padding: 14px;
    border-radius: 50%;
    display: flex;
    margin-bottom: 28px;
  }
  .leader-grid h3 {
    font-size: 1.4rem;
    line-height: 1.3;
  }
  .leader-grid article > p:not(.eyebrow) {
    color: #53657a;
    font-size: 0.87rem;
  }
  .leader-grid dl {
    width: 100%;
    font-size: 0.78rem;
    margin-block: auto 24px;
    padding-top: 10px;
  }
  .leader-grid dl > div {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    border-bottom: 1px solid #e7ebf1;
    padding: 10px 0;
  }
  .leader-grid dd {
    margin: 0;
    font-weight: 700;
  }
  .leader-grid .text-link {
    font-size: 0.78rem;
  }
  .directory-note {
    margin-top: 20px;
  }
  .council-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 28px;
    margin: 30px 0;
  }
  .council-grid article {
    padding: 24px;
    background: #f3f6fa;
    border-radius: 7px;
  }
  .council-grid h3 {
    border-bottom: 3px solid #edbf4b;
    padding-bottom: 14px;
  }
  .council-grid ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .council-grid li {
    padding: 8px 0;
    font-size: 0.86rem;
    line-height: 1.6;
  }
  .table-scroll {
    overflow-x: auto;
    margin-top: 25px;
    border: 1px solid #dbe3ed;
    border-radius: 7px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 490px;
  }
  caption {
    text-align: left;
    padding: 16px 22px;
    background: #edf2f8;
    font-size: 0.78rem;
  }
  thead {
    background: #142f53;
    color: #fff;
  }
  th,
  td {
    padding: 18px 22px;
    border-bottom: 1px solid #dbe3ed;
    font-size: 0.85rem;
  }
  tbody th {
    font-weight: 400;
  }
  tbody th strong {
    display: block;
    font-weight: 650;
  }
  tbody th span {
    display: block;
    font-size: 0.76rem;
    color: #53657a;
    margin-top: 4px;
  }
  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }
  .directory-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  .directory-links > a {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 22px;
    background: #f3f6fa;
    border: 1px solid #dbe3ed;
    border-radius: 7px;
    text-decoration: none;
  }
  .directory-links > a > span {
    flex: 1;
  }
  .directory-links strong {
    display: block;
    font-size: 0.87rem;
  }
  .directory-links small {
    display: block;
    font-size: 0.75rem;
    color: #53657a;
  }
  .help-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    padding: 30px;
    background: #fff5d8;
    border-radius: 7px;
    margin-bottom: 45px;
  }
  .help-box h2 {
    font-size: 1.7rem;
  }
  .help-box p {
    font-size: 0.87rem;
    max-width: 660px;
    margin: 0;
  }
  .help-box a {
    flex-shrink: 0;
  }
  .sources {
    border-top: 1px solid #dbe3ed;
    padding-top: 30px;
    font-size: 0.8rem;
    color: #53657a;
  }
  .sources h2 {
    font-size: 1.5rem;
    color: #142d50;
  }
  .sources ul {
    padding-left: 20px;
  }
  .sources li {
    margin-bottom: 12px;
  }
  .sources a span {
    display: block;
    font-size: 0.7rem;
    overflow-wrap: anywhere;
  }
  @media (max-width: 850px) {
    .leader-grid {
      grid-template-columns: 1fr;
    }
    .leader-grid article {
      display: block;
    }
    .leader-grid dl {
      margin-top: 20px;
    }
    .leader-grid h3 {
      font-size: 1.5rem;
    }
    .council-grid {
      grid-template-columns: 1fr 1fr;
    }
    .directory-links {
      grid-template-columns: 1fr;
    }
    .help-box {
      display: block;
    }
    .help-box a {
      margin-top: 22px;
    }
  }
  @media (max-width: 520px) {
    .council-grid {
      grid-template-columns: 1fr;
    }
    .leader-grid article {
      padding: 24px;
    }
    .help-box {
      padding: 24px;
    }
  }
</style>
