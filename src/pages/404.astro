---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="This page could not be found. Return to Better Pasay’s service directory or homepage."
>
  <section class="container not-found">
    <p class="eyebrow">404 / A missed turn</p>
    <h1>Let’s find your way back.</h1>
    <p class="lead">
      This page may have moved, or the address may be incomplete.
    </p>
    <div class="inline-actions">
      <a class="button" href="/services/">
        Find a public service →
      </a>
      <a href="/">Go to the homepage</a>
    </div>
  </section>
</Base>
