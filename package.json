{
  "name": "better-pasay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --ignore-lock",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --ignore-lock",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/content.test.mjs",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "validate": "npm run format:check && npm run lint && npm run check && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
